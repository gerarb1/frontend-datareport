---
import BaseLayout from './BaseLayout.astro';
import { Sidebar } from '../components/common/Sidebar';
import { AppProviders } from '../components/providers/AppProviders';

interface Props {
  title?: string;
  seccion?: string;
  subtitulo?: string;
}

const {
  title,
  seccion = 'Módulo',
  subtitulo,
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<BaseLayout title={title}>
  <div class="flex h-screen overflow-hidden">
    <!-- Sidebar React Island -->
    <Sidebar client:load currentPath={currentPath} />

    <!-- Main Workspace Area -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden bg-base">
      <!-- Topbar Instrumental -->
      <header class="h-12 bg-white border-b border-border px-6 flex items-center justify-between shrink-0 select-none">
        <div class="flex items-center gap-2">
          <span class="text-xs uppercase font-mono tracking-wider text-ink-subtle">{seccion}</span>
          {subtitulo && (
            <>
              <span class="text-border">/</span>
              <span class="text-xs font-semibold text-ink truncate">{subtitulo}</span>
            </>
          )}
        </div>

        <div class="flex items-center gap-3 text-xs font-mono text-ink-muted">
          <span class="bg-[#F0F2F0] px-2 py-0.5 border border-border rounded-[3px] text-[11px]">
            API v1
          </span>
          <span id="system-clock" class="hidden sm:inline">UTC: 2026</span>
        </div>
      </header>

      <!-- Scrollable Main Content -->
      <main class="flex-1 overflow-y-auto p-6">
        <AppProviders client:load>
          <slot />
        </AppProviders>
      </main>
    </div>
  </div>
</BaseLayout>

<script>
  // Simple instrumental UTC time indicator
  function updateTime() {
    const el = document.getElementById('system-clock');
    if (el) {
      const now = new Date();
      el.textContent = now.toISOString().replace('T', ' ').substring(0, 19) + ' UTC';
    }
  }
  updateTime();
  setInterval(updateTime, 1000);
</script>
