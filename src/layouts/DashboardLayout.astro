---
// src/layouts/DashboardLayout.astro
import BaseLayout from './BaseLayout.astro';
import { Sidebar } from '../components/common/Sidebar';

interface Props {
  title?: string;
  seccion?: string;
  subtitulo?: string;
}

const { title, seccion = 'Módulo', subtitulo } = Astro.props;
const currentPath = Astro.url.pathname;
---

<BaseLayout title={title}>
  <div class="flex h-screen overflow-hidden">
    <Sidebar client:load currentPath={currentPath} />

    <div class="flex-1 flex flex-col min-w-0 overflow-hidden bg-base">
      <header class="h-12 bg-white border-b border-border px-6 flex items-center justify-between shrink-0 select-none">
        {/* Tu código del header se mantiene intacto */}
      </header>

      <main class="flex-1 overflow-y-auto p-6">
        <!-- El slot se renderiza como HTML puro sin islas intermedias -->
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>