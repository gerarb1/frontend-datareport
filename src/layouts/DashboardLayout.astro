---
// src/layouts/DashboardLayout.astro
import BaseLayout from './BaseLayout.astro';
import { Sidebar } from '../components/common/Sidebar';
import { Topbar } from '../components/common/Topbar';

interface Props {
  title?: string;
  seccion?: string;
  subtitulo?: string;
}

const { title, seccion, subtitulo } = Astro.props;
const currentPath = Astro.url.pathname;
---

<BaseLayout title={title}>
  <div class="min-h-screen flex bg-base text-ink overflow-hidden">
    <!-- Sidebar Colapsable Google Style -->
    <Sidebar client:load currentPath={currentPath} />

    <!-- Área de Contenido Principal -->
    <div class="flex-1 flex flex-col min-w-0 h-screen overflow-hidden">
      <!-- Topbar Superior con Breadcrumb y Acciones -->
      <Topbar client:load seccion={seccion} subtitulo={subtitulo} />

      <!-- Contenedor Principal con Scroll Independiente -->
      <main class="flex-1 p-4 sm:p-6 lg:p-8 overflow-y-auto w-full">
        <div class="max-w-7xl mx-auto w-full">
          <slot />
        </div>
      </main>
    </div>
  </div>
</BaseLayout>